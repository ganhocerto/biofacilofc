rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'jeanncarllostk00@gmail.com' ||
          request.auth.token.email.lower() == 'jeannmkt2@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isApprovedUser() {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        )
      );
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && (
        (incoming().role == 'user' && incoming().status == 'pending') ||
        isAdmin()
      );

      allow update: if (
        isAdmin() ||
        (
          isOwner(userId) &&
          // Users cannot self-elevate to admin or self-approve status
          (incoming().role == 'user' || incoming().role == existing().role) &&
          (incoming().status == 'pending' || incoming().status == existing().status)
        )
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // ADMINS COLLECTION
    // ==========================================
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==========================================
    // NICHES COLLECTION
    // ==========================================
    match /niches/{nicheId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // TEMPLATES COLLECTION
    // ==========================================
    match /templates/{templateId} {
      allow get: if resource.data.status == 'published' || isAdmin();
      allow list: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // ==========================================
    // PROJECTS COLLECTION
    // ==========================================
    match /projects/{projectId} {
      allow get: if (isApprovedUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isApprovedUser() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isApprovedUser() && isValidId(projectId) && (
        incoming().userId == request.auth.uid || isAdmin()
      );

      allow update: if isApprovedUser() && (
        (existing().userId == request.auth.uid && incoming().userId == existing().userId) ||
        isAdmin()
      );

      allow delete: if isApprovedUser() && (
        existing().userId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
